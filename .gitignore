# ── 저장소에 넣지 않는 것 ─────────────────────────────

# 사업 자료 (Google Drive 에 원본이 있다. 코드 저장소에는 넣지 않는다)
/google-drive/
/documents/
# 테스트용 실제 은행 파일 — 개인정보라 절대 올리지 않는다
/data/
/.local-backups/

# 설치·빌드·도구가 만드는 것 (npm ci 로 언제든 다시 생긴다)
node_modules/
# Cloudflare 배포 도구 캐시
.wrangler/
# Playwright 실패 기록
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 개인 환경
.DS_Store
.claude/settings.local.json
# OMC(oh-my-claudecode) 실행 상태 — 세션 기록·프롬프트·기계별 경로가 들어간다.
# 프로젝트 스킬(.omc/skills/)만 공유할 수 있게 남긴다 (OMC 공식 규칙과 같다)
.omc/*
!.omc/skills/
# OMC 설정 도구(omc-setup)가 복사해 두는 스킬 사본 — 플러그인이 같은 것을 준다
.claude/skills/wiki/
.vscode/
.idea/
*.log
npm-debug.log*

# 비밀 값 — 토큰·키는 저장소가 아니라 GitHub Secrets 에 둔다
.env
.env.*
.dev.vars

# Obsidian 으로 docs 를 볼 때 생기는 설정 폴더
.obsidian/

# VDI 에서 받은 실행 환경 · 캐시 · 분석 결과 (공유하지 않는다)
.offline/
