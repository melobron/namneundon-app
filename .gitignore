# ── 저장소에 넣지 않는 것 ─────────────────────────────

# 사업 자료 (Google Drive 에 원본이 있다. 코드 저장소에는 넣지 않는다)
/google-drive/
/documents/
# 테스트용 실제 은행 파일 — 개인정보라 절대 올리지 않는다
/data/
/.local-backups/

# 설치·빌드·도구가 만드는 것 (npm ci 로 언제든 다시 생긴다)
node_modules/
# Cloudflare 배포 도구 캐시
.wrangler/
# Playwright 실패 기록
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 개인 환경
.DS_Store
.claude/settings.local.json
.vscode/
.idea/
*.log
npm-debug.log*

# 비밀 값 — 토큰·키는 저장소가 아니라 GitHub Secrets 에 둔다
.env
.env.*
.dev.vars
