{
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules/**",
    "**/*.min.js",
    "package-lock.json",
    "tests/snapshots/**",
    "google-drive/**",
    "test-results/**",
    "landing/**",
    "**/*.png",
    ".git/**",
    "cspell-words.txt",
    ".claude/CLAUDE.md",
    ".offline/**"
  ],
  "ignoreRegExpList": ["data:[^\\s'\"]+", "#[0-9a-fA-F]{3,8}\\b"],
  "dictionaryDefinitions": [
    {
      "name": "project",
      "path": "./cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "project",
    "html",
    "css",
    "node",
    "typescript",
    "npm",
    "companies",
    "softwareTerms"
  ],
  "languageSettings": [
    {
      "languageId": "*",
      "locale": "*",
      "ignoreRegExpList": ["/[\\uAC00-\\uD7A3\\u3131-\\u318E]+/gu"]
    }
  ]
}
