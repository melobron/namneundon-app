// 팀 대시보드 배포 설정 — 고객 앱(루트 wrangler.jsonc)과 따로다. (2026-09-29, 아직 배포하지 않음)
// ★ 배포 전에 사용자가 정할 것: 주소(제안 team.namneundon.com), Access 앱 · 허용 계정 · 요금제,
//   ACCESS_TEAM_DOMAIN · ACCESS_AUD 값, 집계 원본 연결 방식. 정하기 전에는 routes 를 넣지 않는다.
// ★ workers.dev · 미리보기 주소를 끈다 — Access 를 거치지 않는 우회 주소를 만들지 않으려는 것이다.
//   Worker 코드도 토큰을 직접 확인하므로, 두 값이 비어 있으면 누구도 들어오지 못한다.
{
  "name": "namneundon-team",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../team-dashboard",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
