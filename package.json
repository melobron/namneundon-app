{
  "name": "namneundon-app",
  "private": true,
  "description": "남는돈 — 은행 거래내역으로 사업 자금 흐름을 보여주는 웹앱. app/(앱)·landing/(소개)을 빌드 없이 Cloudflare 에 그대로 올린다. 이 파일은 개발 도구(테스트·배포) 설정이다",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/setup.mjs --check",
    "prepare": "husky",
    "serve": "node tests/serve.mjs",
    "check": "node tools/check-load-order.mjs",
    "lint": "npm run format:check && npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:spell && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"app/**/*.css\" --max-warnings 110",
    "lint:html": "html-validate app/index.html landing/index.html landing/404.html --max-warnings 0",
    "lint:spell": "cspell --no-progress \"**/*.{js,mjs,json,jsonc,md,yml,yaml,css,html}\"",
    "typecheck": "tsc -p tsconfig.json && node tools/typecheck-app.mjs",
    "test": "npm run check && playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:prod": "BASE_URL=https://app.namneundon.com playwright test",
    "deploy:app": "wrangler deploy",
    "deploy:landing": "wrangler pages deploy landing --project-name namneundon --branch main",
    "verify:prod": "node tools/verify-deploy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "cspell": "^10.3.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "html-validate": "^11.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.139.0"
  },
  "lint-staged": {
    "*.{js,mjs,json,jsonc,md,yml,yaml,css}": "prettier --write",
    "*.{js,mjs}": "eslint",
    "*.css": "stylelint",
    "*.html": "html-validate",
    "*": "cspell --no-progress --no-must-find-files"
  }
}
