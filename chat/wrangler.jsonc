{
  "name": "namneundon-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chat.namneundon.com", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "namneundon-chat",
      "database_id": "700658f4-3ae7-41bd-ac3c-5b1c75b6b012"
    }
  ],
  "observability": { "enabled": false },
  "triggers": { "crons": ["15 * * * *"] },
  "vars": {
    "CHAT_MODEL": "TODO_MODEL",
    "DAILY_NEURONS": "8000",
    "ACCESS_TEAM": "TODO_TEAM",
    "ACCESS_AUD": "TODO_AUD"
  }
}
