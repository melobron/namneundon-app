{
  "name": "namneundon-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chat.namneundon.com", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "namneundon-chat",
      "database_id": "700658f4-3ae7-41bd-ac3c-5b1c75b6b012"
    }
  ],
  "observability": { "enabled": false },
  "triggers": { "crons": ["15 * * * *"] },
  "vars": {
    "CHAT_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "DAILY_NEURONS": "8000",
    "ACCESS_TEAM": "bitter-rice-6e3b",
    "ACCESS_AUD": "1ec7024ad05f0f02abd988486ce27994faaa81ac9aec2842922f79efb124068f"
  }
}
